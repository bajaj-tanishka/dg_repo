# DGSense Environment Configuration

# Backend API Configuration
DGSENSE_BACKEND_HOST=127.0.0.1
DGSENSE_BACKEND_PORT=8000
DGSENSE_DEBUG=False
DGSENSE_ARTIFACTS_DIR=backend/artifacts

# Model & Inference Parameters
DGSENSE_MIN_CONFIDENCE=0.65
DGSENSE_FEATURE_SCHEMA_VERSION=dgsense-v1
DGSENSE_SEQUENCE_LENGTH=30
DGSENSE_FEATURE_DIM=144
DGSENSE_DEVICE=cpu

# Frontend Vite Configuration (VITE_ prefix for client exposure)
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_MIN_CONFIDENCE=0.65
VITE_PREDICTION_INTERVAL_MS=300
VITE_SEQUENCE_LENGTH=30
